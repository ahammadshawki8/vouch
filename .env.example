# Copy to .env.local and fill in from Firebase console > Project settings > Your apps > Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check: reCAPTCHA Enterprise site key (Firebase console > App Check > Apps).
VITE_RECAPTCHA_ENTERPRISE_KEY=
# Optional in development: a debug token registered in App Check > Manage debug tokens.
VITE_APPCHECK_DEBUG_TOKEN=

# Cloud models (Gemini Developer API via Firebase AI Logic).
VITE_COMPILER_MODEL=gemini-3.8-flash
VITE_CHECK_MODEL=gemini-3.8-flash
